@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 0 0% 98%;
    --foreground: 180 8% 5%;

    --muted: 180 7% 94%;
    --muted-foreground: 180 6% 45%;

    --popover: 0 0% 98%;
    --popover-foreground: 180 8% 5%;

    --card: 0 0% 98%;
    --card-foreground: 180 8% 5%;

    --border: 214.3 31.8% 91.4%;
    --input: 214.3 31.8% 91.4%;

    --primary: 180 100% 25%;
    --primary-foreground: 0 0% 98%;

    --secondary: 180 7% 94%;
    --secondary-foreground: 180 8% 5%;

    --accent: 180 7% 94%;
    --accent-foreground: 180 8% 5%;

    --destructive: 0 84% 60%;
    --destructive-foreground: 0 0% 98%;

    --border: 180 6% 90%;
    --input: 180 6% 83%;
    --ring: 180 24% 75%;

    --radius: 0.5rem;
  }

  .dark {
    --background: 180 3% 6%;
    --foreground: 0 0% 98%;

    --card: 180 6% 7%;
    --card-foreground: 0 0% 98%;

    --popover: 180 6% 7%;
    --popover-foreground: 0 0% 98%;

    --primary: 180 100% 25%;
    --primary-foreground: 0 0% 98%;

    --secondary: 180 5% 15%;
    --secondary-foreground: 0 0% 98%;

    --muted: 180 5% 22%;
    --muted-foreground: 180 5% 49%;

    --accent: 180 45% 14%;
    --accent-foreground: 0 0% 98%;

    --destructive: 0 84% 60%;
    --destructive-foreground: 0 0% 98%;

    --border: 180 5% 12%;
    --input: 180 4% 18%;
    --ring: 180 100% 40%;

  }
}

@layer base {
  * {
    @apply border-border;
  }
  body {
    @apply bg-background text-foreground;
  }
}
